# Database Connection
# Local development (SQLite, zero external setup):
DATABASE_URL="file:./dev.db"

# Production deployment (Managed PostgreSQL on Neon or Supabase):
# DATABASE_URL="postgresql://username:password@ep-sample-123.ap-southeast-1.aws.neon.tech/agriconnect?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-secret-key-here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Email / SMS notification gateways
RESEND_API_KEY="your-resend-api-key"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
